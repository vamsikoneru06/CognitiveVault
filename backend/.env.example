# =============================================================
# CognitiveVault — Environment Variables Template
# =============================================================
# INSTRUCTIONS:
#   1. Copy this file:  copy .env.example .env
#   2. Fill in any values you want to change (defaults are fine to start)
#   3. NEVER commit the .env file to git — it may contain secrets
#
# This file (.env.example) IS safe to commit. It shows the shape
# of the config without any real secrets.

# ---- Application ----
APP_NAME=CognitiveVault
APP_VERSION=1.0.0
DEBUG=True

# ---- Qdrant Vector Database ----
# If running Qdrant via Docker (recommended), use these defaults.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=cognitive_vault

# ---- Ollama Local LLM ----
# Ollama runs on your machine and exposes this URL.
# Change OLLAMA_MODEL to "mistral" if you prefer Mistral over Llama3.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- HuggingFace Embeddings ----
# all-MiniLM-L6-v2 is fast, accurate, and produces 384-dimensional vectors.
# It will be downloaded automatically on first run (~90MB).
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ---- File Upload Security ----
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads
